--!nocheck
-- Renders docs/CONTENT_MANIFEST.md from the live content data (so it can never drift: the content
-- test suite regenerates it and compares).
local Manifest = {}

-- Items exercised end to end in the offline simulator (tests/integration.luau, tests/client.luau).
Manifest.SimulatedEndToEnd = {
	animal = { croakle = true },
	food = { dewberry = true, dewberry_jam = true, field_pea = true, mango = true },
	recipe = { cook_dewberry_jam = true, lure_dewhop = true },
	quest = { visit_croakle = true },
	decoration = { daisy_lantern = true, clover_bench = true },
	upgrade = { rapport_hopper = true },
}

local function habitatName(config, id)
	return config.Habitats[id] and config.Habitats[id].Name or id
end

function Manifest.rows(config)
	local rows = {}
	local function add(category, id, location, access)
		table.insert(rows, { category, id, location, access })
	end
	for _, id in ipairs(config.VisitorOrder) do
		local s = config.Species[id]
		local fav
		for f, p in pairs(s.Preferences) do
			if p == "favorite" then
				fav = f
			end
		end
		add(
			"animal",
			id,
			"Content/Animals.luau",
			string.format("%s visitor (%s); rotating slot or `lure_%s`; favourite %s", habitatName(config, s.Habitat), s.Archetype, id, fav)
		)
	end
	for _, id in ipairs(config.ExpansionFoodOrder) do
		local f = config.Foods[id]
		local how = if f.Kind == "harvest"
			then string.format(
				"Pantry: learn %d coins + %d research, batch %d coins",
				f.UnlockCost.Coins,
				f.UnlockCost.Research,
				f.BatchCost
			)
			else string.format("Kitchen: `cook_%s` (tier %d)", id, f.Tier)
		add(
			"food",
			id,
			"Content/Foods.luau",
			string.format("%s %s, %s; %s; throw/feast/ingredient", habitatName(config, f.Habitat), f.Kind, f.Tag, how)
		)
	end
	for _, id in ipairs(config.RecipeOrder) do
		local r = config.Recipes[id]
		local out = r.Output.Food or r.Output.Lure or r.Output.Decoration
		add(
			"recipe",
			id,
			"Content/Recipes.luau",
			string.format("%s %s; needs %d research + %s; makes %s", r.Station, r.Kind, r.Research, table.concat(r.Habitats, "/"), out)
		)
	end
	for _, id in ipairs(config.QuestOrder) do
		local q = config.Quests[id]
		local o = q.Objective
		add(
			"quest",
			id,
			"Content/Quests.luau",
			string.format(
				"%s: %s %s x%d%s; reward %d coins%s",
				q.Group,
				o.Kind,
				o.Target or "",
				o.Count,
				if q.Requires then " after `" .. q.Requires .. "`" else "",
				q.Reward.Coins,
				if q.Reward.Decoration then " + " .. q.Reward.Decoration else ""
			)
		)
	end
	for _, id in ipairs(config.DecorationOrder) do
		local d = config.Decorations[id]
		local how = if d.Source == "shop"
			then string.format("Decor shop %d coins + %d research", d.Cost.Coins, d.Cost.Research)
			elseif d.Source == "craft" then "Workbench recipe"
			else "quest reward"
		add(
			"decoration",
			id,
			"Content/Decorations.luau",
			string.format(
				"%s %s; %s; place on a plot: comfort %d, favours %s",
				habitatName(config, d.Habitat),
				d.Template,
				how,
				d.Comfort,
				d.Favored
			)
		)
	end
	for _, id in ipairs(config.ExpansionUpgradeOrder) do
		local u = config.Upgrades[id]
		add(
			"upgrade",
			id,
			"Content/Upgrades.luau",
			string.format(
				"%s: %s %s; %d levels; %s",
				u.Category,
				u.Effect.Kind,
				u.Effect.Target or "",
				#u.Levels,
				if u.Requires then "needs " .. u.Requires.Id .. " " .. u.Requires.Level else "no prerequisite"
			)
		)
	end
	return rows
end

function Manifest.render(config)
	local lines = {
		"# Content manifest: 1,000 expansion additions",
		"",
		"Generated by `lune run scripts/manifest.luau` from `src/shared/Content` (do not edit by hand; `tests/content.luau` fails if this file is stale).",
		"",
		"Verification legend:",
		"- **D**: per-item data checks in `tests/content.luau` (ids, names, descriptions, cross-references, ranges, cycles).",
		"- **R**: obtained by the seeded rules bot in `tests/content.luau` (offline, real Economy rules, no purchases).",
		"- **S**: also exercised end to end in the offline engine simulator (`tests/integration.luau` / `tests/client.luau`).",
		"",
		"None of these items has been played in Roblox Studio or on a device.",
		"",
		"| # | Category | Id | Implementation | Acquisition / unlock / use | Verified |",
		"|---|---|---|---|---|---|",
	}
	local counts = {}
	for i, row in ipairs(Manifest.rows(config)) do
		counts[row[1]] = (counts[row[1]] or 0) + 1
		local sim = Manifest.SimulatedEndToEnd[row[1]][row[2]]
		table.insert(
			lines,
			string.format(
				"| %d | %s | `%s` | `src/shared/%s` | %s | D, R%s |",
				i,
				row[1],
				row[2],
				row[3],
				(string.gsub(row[4], "|", "/")),
				if sim then ", S" else ""
			)
		)
	end
	table.insert(lines, "")
	table.insert(
		lines,
		string.format(
			"Totals: %d animals, %d foods, %d recipes, %d quests, %d decorations, %d upgrades.",
			counts.animal or 0,
			counts.food or 0,
			counts.recipe or 0,
			counts.quest or 0,
			counts.decoration or 0,
			counts.upgrade or 0
		)
	)
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return Manifest
