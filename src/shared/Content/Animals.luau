local ARCHETYPE_DEFAULTS = {
	hopper = { walk = 9, scale = 0.9, mouth = 2.0, body = 2.1, sense = 26 },
	bird = { walk = 7, scale = 0.95, mouth = 2.0, body = 2.3, sense = 24 },
	tortoise = { walk = 4.5, scale = 1.2, mouth = 2.2, body = 3.0, sense = 22 },
	fox = { walk = 11, scale = 1.0, mouth = 1.8, body = 2.2, sense = 28 },
	otter = { walk = 9, scale = 1.05, mouth = 2.0, body = 2.3, sense = 26 },
	crab = { walk = 6, scale = 1.0, mouth = 2.1, body = 2.4, sense = 22 },
	frog = { walk = 8, scale = 0.95, mouth = 2.1, body = 2.0, sense = 24 },
	snail = { walk = 3.5, scale = 1.0, mouth = 1.9, body = 2.1, sense = 20 },
	moth = { walk = 10, scale = 0.9, mouth = 1.8, body = 2.0, sense = 28 },
	boar = { walk = 7.5, scale = 1.1, mouth = 2.1, body = 2.6, sense = 24 },
}

local HABITAT_COINS = { meadow = 3, grove = 5, lagoon = 8 }

local function hex(h: string): { number }
	return {
		tonumber(string.sub(h, 1, 2), 16) :: number,
		tonumber(string.sub(h, 3, 4), 16) :: number,
		tonumber(string.sub(h, 5, 6), 16) :: number,
	}
end

local Animals = {}

Animals.Rows = ROWS
Animals.ArchetypeDefaults = ARCHETYPE_DEFAULTS

-- Returns (defs, order). `hintFor(favoriteFood)` writes a journal hint from the food's tag.
function Animals.build(firstOrder: number, hintFor: (string) -> string): ({ [string]: any }, { string })
	local defs: { [string]: any } = {}
	local order: { string } = {}
	local perHabitat: { [string]: number } = {}
	for _, row in ipairs(ROWS) do
		local id, name, habitat, archetype, body, accent, feature, favorite, disliked, description =
			row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8], row[9], row[10]
		local i = (perHabitat[habitat] or 0) + 1
		perHabitat[habitat] = i
		local base = ARCHETYPE_DEFAULTS[archetype]
		-- Small deterministic per-species variety so two visitors of one body plan differ.
		local wobble = ((i * 37) % 11 - 5) / 50 -- -0.10 .. +0.10
		table.insert(order, id)
		defs[id] = {
			Id = id,
			Name = name,
			Order = firstOrder + #order,
			Habitat = habitat,
			Visitor = true,
			BaseCoins = HABITAT_COINS[habitat] + (i % 4),
			BaseTrust = 1,
			Count = 0, -- spawned through visitor slots, never permanently
			Preferences = { [favorite] = "favorite", [disliked] = "disliked" },
			WalkSpeed = math.floor(base.walk * (1 + wobble) * 10 + 0.5) / 10,
			Scale = math.floor(base.scale * (1 - wobble) * 100 + 0.5) / 100,
			BodyColor = hex(body),
			AccentColor = hex(accent),
			Archetype = archetype,
			Feature = feature,
			MouthRadius = base.mouth,
			BodyRadius = base.body,
			SenseRadius = base.sense,
			Description = description,
			Hint = hintFor(favorite),
		}
	end
	return defs, order
end

return Animals
