-- Comfort and Decor-shop price by template (base) and by position within the island (step).
local TEMPLATE_COMFORT = {
	lantern = 2,
	statue = 4,
	bench = 3,
	planter = 2,
	fence = 1,
	arch = 4,
	fountain = 4,
	banner = 2,
	totem = 3,
	mushroom = 2,
	shells = 1,
	signpost = 1,
	birdbath = 3,
	chime = 2,
}
local HABITAT_PRICE = { meadow = { 25, 6 }, grove = { 70, 9 }, lagoon = { 130, 12 } }
local HABITAT_RESEARCH = { meadow = 0, grove = 3, lagoon = 8 }
local SOURCE = { S = "shop", Q = "quest", C = "craft" }

local function hex(h: string): { number }
	return {
		tonumber(string.sub(h, 1, 2), 16) :: number,
		tonumber(string.sub(h, 3, 4), 16) :: number,
		tonumber(string.sub(h, 5, 6), 16) :: number,
	}
end

local Decorations = {}

Decorations.Rows = ROWS
Decorations.Templates = TEMPLATE_COMFORT

function Decorations.build(): ({ [string]: any }, { string })
	local defs: { [string]: any } = {}
	local order: { string } = {}
	local perHabitat: { [string]: number } = {}
	for _, row in ipairs(ROWS) do
		local id, name, habitat, template, primary, secondary, species, source, description =
			row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8], row[9]
		local i = (perHabitat[habitat] or 0) + 1
		perHabitat[habitat] = i
		local price = HABITAT_PRICE[habitat]
		local kind = SOURCE[source]
		local bonusTier = if kind == "shop" then 1 else 2 -- quest and crafted pieces are a bit stronger
		table.insert(order, id)
		defs[id] = {
			Id = id,
			Name = name,
			Order = #order,
			Habitat = habitat,
			Template = template,
			Primary = hex(primary),
			Secondary = hex(secondary),
			Scale = 0.9 + ((i * 7) % 5) * 0.08,
			Source = kind,
			Cost = if kind == "shop"
				then { Coins = price[1] + price[2] * (i - 1), Research = HABITAT_RESEARCH[habitat] + (i - 1) // 8 }
				else nil,
			Comfort = TEMPLATE_COMFORT[template] + bonusTier - 1,
			Favored = species,
			FavoredCoinBonus = 0.1 * bonusTier, -- +10% (+20% for quest/crafted) coins from that species
			FavoredTrustBonus = bonusTier, -- extra trust points per accepted meal from that species
			Description = description,
		}
	end
	return defs, order
end

return Decorations
