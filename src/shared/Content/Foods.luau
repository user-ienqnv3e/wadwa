local SHAPES = { B = "Ball", K = "Block", C = "Cylinder" }

local function hex(h: string): { number }
	return {
		tonumber(string.sub(h, 1, 2), 16) :: number,
		tonumber(string.sub(h, 3, 4), 16) :: number,
		tonumber(string.sub(h, 5, 6), 16) :: number,
	}
end

local function parseInputs(text: string): { [string]: number }
	local inputs = {}
	for id, count in string.gmatch(text, "([%w_]+):(%d+)") do
		inputs[id] = tonumber(count) :: number
	end
	return inputs
end

-- Per-habitat pricing for harvest foods (index i = 1..20 within the habitat).
local HARVEST_PRICING = {
	meadow = { coins = 18, coinsStep = 9, research = 1, researchEvery = 4, batch = 5, value = 1.6 },
	grove = { coins = 60, coinsStep = 12, research = 4, researchEvery = 3, batch = 8, value = 2.1 },
	lagoon = { coins = 120, coinsStep = 15, research = 8, researchEvery = 3, batch = 11, value = 2.6 },
}
local COOKED_VALUE = { 3, 4.5, 6 } -- by tier
local function cookedTier(i: number): number
	return if i <= 12 then 1 elseif i <= 22 then 2 else 3
end

export type Row = { any }

local Foods = {}

Foods.Harvest = HARVEST
Foods.Cooked = COOKED

-- Returns (defs, order). Order numbers start after the core foods.
function Foods.build(firstOrder: number, tagIcons: { [string]: string }): ({ [string]: any }, { string })
	local defs: { [string]: any } = {}
	local order: { string } = {}
	local perHabitat: { [string]: number } = {}
	for _, row in ipairs(HARVEST) do
		local id, name, habitat, tag, shape, color, description = row[1], row[2], row[3], row[4], row[5], row[6], row[7]
		local i = (perHabitat[habitat] or 0) + 1
		perHabitat[habitat] = i
		local p = HARVEST_PRICING[habitat]
		table.insert(order, id)
		defs[id] = {
			Id = id,
			Name = name,
			Order = firstOrder + #order,
			Kind = "harvest",
			Tag = tag,
			Habitat = habitat,
			Tier = 1 + (i - 1) // 7,
			Value = math.floor((p.value + 0.1 * (i - 1)) * 100 + 0.5) / 100,
			Free = false,
			UnlockCost = { Coins = p.coins + p.coinsStep * (i - 1), Research = p.research + (i - 1) // p.researchEvery },
			RequiresHabitat = if habitat == "meadow" then nil else habitat,
			BatchCost = p.batch + (i - 1) // 2,
			Color = hex(color),
			Shape = SHAPES[shape],
			Size = if shape == "B" then 1 else 1.1,
			Icon = tagIcons[tag],
			Description = description,
		}
	end
	local cookedIndex: { [string]: number } = {}
	for _, row in ipairs(COOKED) do
		local id, name, habitat, tag, shape, color, inputs, description = row[1], row[2], row[3], row[4], row[5], row[6], row[7], row[8]
		local i = (cookedIndex[habitat] or 0) + 1
		cookedIndex[habitat] = i
		local tier = cookedTier(i)
		table.insert(order, id)
		defs[id] = {
			Id = id,
			Name = name,
			Order = firstOrder + #order,
			Kind = "cooked",
			Tag = tag,
			Habitat = habitat,
			Tier = tier,
			Value = COOKED_VALUE[tier] + 0.05 * (i % 10),
			Free = false,
			UnlockCost = { Coins = 0, Research = 0 }, -- never bought: only cooked
			BatchCost = 0,
			Inputs = parseInputs(inputs),
			Color = hex(color),
			Shape = SHAPES[shape],
			Size = 1.15 + 0.1 * (tier - 1),
			Icon = tagIcons[tag],
			Description = description,
		}
	end
	return defs, order
end

return Foods
